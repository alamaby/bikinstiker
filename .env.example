# =============================================================================
# BikinStiker — root-level environment sample
# =============================================================================
# This file documents every secret/env var the project uses across:
#   1. Supabase Edge Function (`generate-sticker`)
#   2. Local `supabase functions serve` runs
#   3. CI / deployment scripts
#
# Copy this file to `.env` (or `.env.local`) and fill in real values.
# NEVER commit the populated file. `.env*` is gitignored.
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase project — used by `supabase` CLI and the edge function runtime
# -----------------------------------------------------------------------------
# Find these in Supabase Studio → Project Settings → API.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key...

# Used by `supabase link` / `supabase db push`.
SUPABASE_PROJECT_REF=YOUR-PROJECT-REF

# -----------------------------------------------------------------------------
# Operator email alerts (best-effort, for actionable provider failures)
# -----------------------------------------------------------------------------
# Required to enable email alerts when a provider fails with credential/config/
# quota/billing issues. All fields are optional — alerts silently no-op if
# RESEND_API_KEY, OPERATOR_ALERT_TO, or OPERATOR_ALERT_FROM are unset.
RESEND_API_KEY=re_...
OPERATOR_ALERT_TO=oncall@example.com
OPERATOR_ALERT_FROM="BikinStiker Alerts <alerts@example.com>"
APP_NAME=BikinStiker

# -----------------------------------------------------------------------------
# Ollama Cloud Reasoning Provider
# -----------------------------------------------------------------------------
# API key for Ollama Cloud (used by reasoning provider gemma4:31b).
# DO NOT set as Edge Function secret. Store in database:
#   UPDATE image_generation_configs
#   SET api_key = 'your-ollama-cloud-api-key', updated_at = now()
#   WHERE provider_name = 'ollama' AND route_scope = 'reasoning';
#
# Direct API model ID: gemma4:31b (NOT gemma4:31b-cloud which is for local daemon).
# Get your API key: https://ollama.com/settings/keys
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Cerebras Cloud Reasoning Provider
# -----------------------------------------------------------------------------
# API key for Cerebras Cloud (used by gemma-4-31b, zai-glm-4.7, gpt-oss-120b).
# One key shared across all Cerebras models.
# DO NOT set as Edge Function secret. Store in database:
#   UPDATE image_generation_configs
#   SET api_key = 'your-cerebras-api-key', updated_at = now()
#   WHERE provider_name = 'cerebras' AND route_scope = 'reasoning';
#
# Models: gemma-4-31b (priority 4), zai-glm-4.7 (priority 5), gpt-oss-120b (priority 6).
# Endpoint: https://api.cerebras.ai/v1/chat/completions
# Reasoning doc: https://inference-docs.cerebras.ai/capabilities/reasoning
# Get your API key: https://cloud.cerebras.ai/
# -----------------------------------------------------------------------------

# =============================================================================
# How to push these to Supabase (Edge Function secrets)
# =============================================================================
# Provider credentials are now stored in DB (image_generation_configs.api_key),
# not in environment variables. However, the following secrets ARE needed:
#
#   supabase secrets set RESEND_API_KEY="re_..."
#   supabase secrets set OPERATOR_ALERT_TO="oncall@example.com"
#   supabase secrets set OPERATOR_ALERT_FROM="BikinStiker Alerts <alerts@example.com>"
#   supabase secrets set APP_NAME="BikinStiker"
#
# SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY are auto-
# injected into every deployed edge function — you do NOT need to `secrets set`
# those.
# =============================================================================

# -----------------------------------------------------------------------------
# Google AdMob Configuration
# -----------------------------------------------------------------------------
# App ID (beda dengan ad unit ID — dari AdMob Console > App > App Settings).
ADMOB_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX

# Banner ad units — per platform agar performa Android/iOS bisa dipantau terpisah.
ADMOB_BANNER_HOME_ANDROID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
ADMOB_BANNER_HOME_IOS=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
ADMOB_BANNER_HISTORY_ANDROID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
ADMOB_BANNER_HISTORY_IOS=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
ADMOB_BANNER_MISSIONS_ANDROID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
ADMOB_BANNER_MISSIONS_IOS=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
ADMOB_BANNER_PROFILE_ANDROID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
ADMOB_BANNER_PROFILE_IOS=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
ADMOB_BANNER_PACKS_ANDROID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
ADMOB_BANNER_PACKS_IOS=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX

# Rewarded ad units — satu per platform.
ADMOB_REWARDED_ANDROID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
ADMOB_REWARDED_IOS=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX

# Web Client ID from Google Cloud Console > Credentials > OAuth 2.0 Client IDs
# This is used by google_sign_in plugin (serverClientId parameter).
# Find it in: https://console.cloud.google.com/apis/credentials
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Also set in Supabase Dashboard > Auth > Providers > Google:
#   - Client ID: (same as above)
#   - Client Secret: (from Google Cloud Console)

# =============================================================================
# GitHub Actions secrets — copy-paste ke GitHub → Settings → Secrets and variables
# =============================================================================
# Workflow "Ping Supabase" (cron harian via .github/workflows/ping-supabase.yml)
# butuh kedua secrets ini.
# SUPABASE_SERVICE_ROLE_KEY: Supabase Dashboard → Settings → API → service_role key
